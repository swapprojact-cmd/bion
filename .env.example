# Vite variables are public client configuration. Never put service-account keys here.
# Firebase Console > Project settings > Your apps provides these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Use (default) for the standard Firestore database, or set a configured named database ID.
VITE_FIRESTORE_DATABASE_ID=ai-studio-bicirclebisexual-7b1ba258-2320-4251-a404-a27b5a1fc949

# Optional server-only / AI Studio values; do not commit real secrets.
GEMINI_API_KEY=
APP_URL=
