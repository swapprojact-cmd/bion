# Vite variables are public client configuration. Never put service-account keys here.
# Firebase Console > Project settings > Your apps provides these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: leave blank to use the default Firestore database.
VITE_FIREBASE_DATABASE_ID=
