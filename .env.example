# Firebase Web App config (copy from Firebase Console > Project settings > Your apps)
# Leave blank to use the checked-in AI Studio fallback config. Replace all values for a fresh project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Use (default) for a new standard Firestore database, or set a configured named database ID.
VITE_FIRESTORE_DATABASE_ID=(default)

# Optional server-only / AI Studio values; do not commit real secrets.
GEMINI_API_KEY=
APP_URL=
