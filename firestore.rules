rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles: public read, authenticated updates
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Confidential private settings: strictly isolated to owner
    match /user_private/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Groups: public read, authenticated create/update
    match /groups/{groupId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Posts: public read, authenticated writes
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Comments: public read, authenticated writes
    match /comments/{commentId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Reports: private to reporter and moderators
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Conversations and messages
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();
    }
    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // Friendships and friend requests
    match /friendships/{friendshipId} {
      allow read, write: if isAuthenticated();
    }
    match /friend_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }
  }
}
