rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function moderator() { return signedIn() && (request.auth.token.moderator == true || request.auth.token.admin == true); }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owns(field) { return signedIn() && resource.data[field] == request.auth.uid; }
    function createsAs(field) { return signedIn() && request.resource.data[field] == request.auth.uid; }
    function memberOfGroup(groupId) {
      return signedIn() && (
        (
          exists(/databases/$(database)/documents/group_members/$(groupId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/group_members/$(groupId + '_' + request.auth.uid)).data.membership_status == 'active'
        )
        || (
          exists(/databases/$(database)/documents/groups/$(groupId))
          && ('memberIds' in get(/databases/$(database)/documents/groups/$(groupId)).data)
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
        )
      );
    }

    function friendshipId(userA, userB) {
      return userA < userB ? userA + '_' + userB : userB + '_' + userA;
    }

    function hasGroupMembership(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/group_members/$(groupId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/group_members/$(groupId + '_' + request.auth.uid)).data.user_id == request.auth.uid
        && get(/databases/$(database)/documents/group_members/$(groupId + '_' + request.auth.uid)).data.membership_status in ['active', 'pending'];
    }

    function canReadPostData(postData) {
      return postData.visibility == 'public'
        || (signedIn() && postData.visibility == 'members_only')
        || (signedIn() && postData.author_id == request.auth.uid)
        || (signedIn() && postData.visibility == 'group_only'
          && postData.group_id is string && memberOfGroup(postData.group_id))
        || (signedIn() && postData.visibility == 'friends_only'
          && postData.author_id is string
          && exists(/databases/$(database)/documents/friendships/$(friendshipId(postData.author_id, request.auth.uid))));
    }

    function conversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.member_ids;
    }

    match /profiles/{userId} {
      allow read: if resource.data.visibility == 'public'
        || (signedIn() && resource.data.visibility == 'members_only')
        || self(userId) || moderator();
      allow create: if self(userId)
        && request.resource.data.id == userId
        && request.resource.data.is_admin == false
        && request.resource.data.is_moderator == false;
      allow update: if self(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.is_admin == resource.data.is_admin
        && request.resource.data.is_moderator == resource.data.is_moderator
        && request.resource.data.status == resource.data.status;
      allow delete: if admin();
    }

    match /user_private/{userId} {
      allow read: if self(userId) || admin();
      allow create, update: if self(userId)
        && request.resource.data.user_id == userId;
      allow delete: if self(userId) || admin();
    }

    match /groups/{groupId} {
      allow read: if resource.data.visibility == 'public'
        || (signedIn() && memberOfGroup(groupId)) || moderator();
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update: if (signedIn() && resource.data.owner_id == request.auth.uid
          && request.resource.data.owner_id == resource.data.owner_id)
        || moderator();
      allow delete: if (signedIn() && resource.data.owner_id == request.auth.uid) || admin();
    }

    match /group_members/{membershipId} {
      allow read: if signedIn() && (
        membershipId.matches('^.*_' + request.auth.uid + '$')
        || resource.data.user_id == request.auth.uid
        || memberOfGroup(resource.data.group_id)
        || (exists(/databases/$(database)/documents/groups/$(resource.data.group_id)
            ) && get(/databases/$(database)/documents/groups/$(resource.data.group_id)).data.owner_id == request.auth.uid)
        || moderator()
      );

      allow create: if signedIn()
        && membershipId == request.resource.data.group_id + '_' + request.resource.data.user_id
        && request.resource.data.user_id == request.auth.uid
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.group_id))
        && (
          (
            get(/databases/$(database)/documents/groups/$(request.resource.data.group_id)).data.owner_id == request.auth.uid
            && request.resource.data.role == 'owner'
            && request.resource.data.membership_status == 'active'
          )
          || (
            request.resource.data.role == 'member'
            && (
              (
                get(/databases/$(database)/documents/groups/$(request.resource.data.group_id)).data.visibility == 'public'
                && request.resource.data.membership_status == 'active'
              )
              || (
                get(/databases/$(database)/documents/groups/$(request.resource.data.group_id)).data.visibility == 'private'
                && request.resource.data.membership_status == 'pending'
              )
            )
          )
        );

      allow update: if moderator()
        || (
          signedIn()
          && get(/databases/$(database)/documents/groups/$(resource.data.group_id)).data.owner_id == request.auth.uid
          && request.resource.data.group_id == resource.data.group_id
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.role == resource.data.role
          && request.resource.data.membership_status in ['active', 'rejected', 'banned']
        );

      allow delete: if (signedIn() && resource.data.user_id == request.auth.uid)
        || (signedIn() && get(/databases/$(database)/documents/groups/$(resource.data.group_id)).data.owner_id == request.auth.uid)
        || moderator();
    }

    match /posts/{postId} {
      allow read: if canReadPostData(resource.data) || moderator();

      allow create: if createsAs('author_id')
        && request.resource.data.status == 'published'
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 10000
        && request.resource.data.visibility in ['public', 'group_only', 'friends_only', 'private']
        && (
          !('group_id' in request.resource.data)
          || request.resource.data.group_id == null
          || (
            request.resource.data.group_id is string
            && memberOfGroup(request.resource.data.group_id)
          )
        )
        && (
          request.resource.data.visibility != 'group_only'
          || request.resource.data.group_id is string
        );

      allow update: if (
          owns('author_id')
          && request.resource.data.author_id == resource.data.author_id
          && request.resource.data.status == resource.data.status
          && request.resource.data.visibility == resource.data.visibility
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'body', 'media_paths', 'video_url', 'media_type', 'is_18_plus',
            'location_name', 'location_lat', 'location_lng', 'updated_at'
          ])
        )
        || moderator();

      allow delete: if owns('author_id') || moderator();

      match /likes/{userId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPostData(get(/databases/$(database)/documents/posts/$(postId)).data);

        allow create: if self(userId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPostData(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.post_id == postId;

        allow delete: if self(userId);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canReadPostData(get(/databases/$(database)/documents/posts/$(postId)).data);

        allow create: if createsAs('author_id')
          && request.resource.data.post_id == postId
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 4000;

        allow update: if owns('author_id')
          && request.resource.data.author_id == resource.data.author_id
          || moderator();

        allow delete: if owns('author_id') || moderator();
      }
    }

    // Legacy top-level comments are kept for the existing data service.
    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if createsAs('author_id') && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000;
      allow update: if owns('author_id') && request.resource.data.author_id == resource.data.author_id
        || moderator();
      allow delete: if owns('author_id') || moderator();
    }

    match /friend_requests/{requestId} {
      allow read: if (signedIn() && (
        requestId.matches('^' + request.auth.uid + '_.*$')
        || resource.data.sender_id == request.auth.uid
        || resource.data.recipient_id == request.auth.uid
      )) || moderator();

      allow create: if createsAs('sender_id')
        && request.resource.data.recipient_id is string
        && request.resource.data.sender_id != request.resource.data.recipient_id
        && request.resource.data.status == 'pending';

      allow update: if signedIn()
        && resource.data.recipient_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.sender_id == resource.data.sender_id
        && request.resource.data.recipient_id == resource.data.recipient_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if (signedIn() && (
        resource.data.sender_id == request.auth.uid
        || resource.data.recipient_id == request.auth.uid
      )) || moderator();
    }

    match /friendships/{friendshipIdValue} {
      allow read: if signedIn() && (
        resource.data.user_a == request.auth.uid
        || resource.data.user_b == request.auth.uid
      ) || moderator();

      allow create: if signedIn()
        && request.resource.data.user_a is string
        && request.resource.data.user_b is string
        && request.resource.data.user_a < request.resource.data.user_b
        && request.auth.uid in [request.resource.data.user_a, request.resource.data.user_b]
        && request.resource.data.accepted_request_id is string
        && existsAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.accepted_request_id))
        && getAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.accepted_request_id)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.accepted_request_id)).data.sender_id in [request.resource.data.user_a, request.resource.data.user_b]
        && getAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.accepted_request_id)).data.recipient_id in [request.resource.data.user_a, request.resource.data.user_b];

      allow update: if false;

      allow delete: if signedIn() && (
        resource.data.user_a == request.auth.uid
        || resource.data.user_b == request.auth.uid
      ) || moderator();
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && (
        blockId.matches('^' + request.auth.uid + '_.*$')
        || resource.data.blocker_id == request.auth.uid
        || resource.data.blocked_id == request.auth.uid
      );

      allow create: if createsAs('blocker_id')
        && request.resource.data.blocked_id is string
        && request.resource.data.blocked_id != request.auth.uid;

      allow delete: if owns('blocker_id');
      allow update: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.member_ids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.member_ids
        && request.resource.data.member_ids is list
        && request.resource.data.member_ids.size() >= 2
        && request.resource.data.member_ids.size() <= 10;
      allow update: if signedIn() && request.auth.uid in resource.data.member_ids
        && request.resource.data.member_ids == resource.data.member_ids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updated_at', 'unread_count']);
      allow delete: if admin();
    }

    match /messages/{messageId} {
      allow read: if conversationMember(resource.data.conversation_id);
      allow create: if conversationMember(request.resource.data.conversation_id)
        && createsAs('sender_id')
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 5000;
      allow update: if false;
      allow delete: if owns('sender_id') || moderator();
    }

    match /notifications/{notificationId} {
      allow read: if owns('recipient_id') || moderator();
      allow create: if signedIn()
        && request.resource.data.recipient_id is string
        && request.resource.data.actor_id == request.auth.uid;
      allow update: if owns('recipient_id')
        && request.resource.data.recipient_id == resource.data.recipient_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_at']);
      allow delete: if owns('recipient_id') || moderator();
    }

    match /reports/{reportId} {
      allow create: if createsAs('reporter_id')
        && request.resource.data.target_id is string
        && request.resource.data.reason is string;
      allow read: if owns('reporter_id') || moderator();
      allow update: if moderator();
      allow delete: if admin();
    }

    match /moderation_actions/{actionId} {
      allow read: if moderator();
      allow create: if admin() && request.resource.data.actor_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Opt-in relationship discovery is kept separate from community profiles.
    // Sexual orientation is only stored in a readable discovery document when the
    // member explicitly chooses to show it; Firestore rules cannot hide individual fields.
    match /relationship_profiles/{userId} {
      allow read: if self(userId)
        || (signedIn() && resource.data.opted_in == true);
      allow create: if self(userId)
        && request.resource.data.uid == userId
        && request.resource.data.opted_in is bool
        && request.resource.data.focus is list
        && request.resource.data.adult_confirmed == true;
      allow update: if self(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.adult_confirmed == true;
      allow delete: if self(userId);
    }

    // Interest is a request, not a connection. Only the recipient can accept/decline.
    match /match_requests/{requestId} {
      function participants() {
        return signedIn() && (resource.data.sender_id == request.auth.uid
          || resource.data.recipient_id == request.auth.uid);
      }
      allow read: if participants();
      allow create: if signedIn()
        && request.resource.data.sender_id == request.auth.uid
        && request.resource.data.recipient_id is string
        && request.resource.data.recipient_id != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.recipient_id
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/relationship_profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/relationship_profiles/$(request.auth.uid)).data.opted_in == true
        && exists(/databases/$(database)/documents/relationship_profiles/$(request.resource.data.recipient_id))
        && get(/databases/$(database)/documents/relationship_profiles/$(request.resource.data.recipient_id)).data.opted_in == true
        && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + request.resource.data.recipient_id))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.recipient_id + '_' + request.auth.uid));
      allow update: if signedIn()
        && resource.data.recipient_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.sender_id == resource.data.sender_id
        && request.resource.data.recipient_id == resource.data.recipient_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
        && request.resource.data.status in ['accepted', 'declined']
        && exists(/databases/$(database)/documents/relationship_profiles/$(resource.data.sender_id))
        && get(/databases/$(database)/documents/relationship_profiles/$(resource.data.sender_id)).data.opted_in == true
        && !exists(/databases/$(database)/documents/blocks/$(resource.data.sender_id + '_' + request.auth.uid))
        && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + resource.data.sender_id));
      allow delete: if participants();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
