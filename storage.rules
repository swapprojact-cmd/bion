rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validImage(maxBytes) {
      return request.resource != null && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /users/{uid}/avatars/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(uid) && validImage(5 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }
    match /users/{uid}/posts/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && validImage(10 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }
    match /groups/{groupId}/{uid}/{fileName} {
      allow read: if signedIn() && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
      allow create, update: if isOwner(uid)
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds
        && validImage(10 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
